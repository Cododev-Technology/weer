# This is an example .env file for the server. You should copy this to .env and fill in the values as needed.

PORT='2080'
DOMAIN='http://localhost:2080'

# OPTIONAL: if you don't want to set the google client ID and secret, you won't be able to log in with Google, but you can still use the app.
# Grab these from the Google Cloud Console by setting up your OAuth credentials here: https://console.cloud.google.com/apis/credentials 
# Make sure to set the authorized redirect URI to http://localhost:2080/auth/google/callback.
GOOGLE_CLIENT_ID='<generate-your-own>.apps.googleusercontent.com'
GOOGLE_CLIENT_SECRET='<grab-from-google-cloud-console>'

COOKIE_KEY='<random-at-least-32-characters>'
TOKEN_SECRET='<random-at-least-32-characters>'

#OPTIONAL: If false, emails are logged to the console instead of sent.
SKIP_EMAIL=true
AWS_REGION='us-east-1'
SES_FROM_EMAIL='Weer <no-reply@yourdomain.com>'

# OPTIONAL: if you don't set this, link creation will skip the malicious-URL check entirely (same behavior as before this feature existed).
# Grab a key from Google Cloud Console (Web Risk API — requires billing enabled, first 100k calls/month free): https://console.cloud.google.com/apis/credentials
WEB_RISK_API_KEY=''

REDIS_URL='redis://127.0.0.1:6379'
REDIS=false # set this to false if you don't want to use Redis (not recommended, as the janitor won't work and views won't be processed)

# server-turbo always uses a Redis cluster (REDIS_URL is the single Redis of the Node.js server).
# Comma separated, any of the nodes is enough. Start a local one with: ./redis.sh -setup
REDIS_CLUSTER_NODES='redis://127.0.0.1:7100'

# OPTIONAL: these are the defaults. Change them for the load tests.
REDIRECT_WARNING=true # false sends every visitor straight to the link, without the warning page
RATE_LIMIT=true # false turns off every rate limit (links, emails, logins)
DB_POOL_SIZE=10 # connections to PostgreSQL per server process

# OPTIONAL (server-turbo only): these are the defaults. Change them for the load tests.
VIEWS_STREAM_SHARDS=16 # how many streams the views are spread over, so they land on many nodes
LINK_CACHE=true # save the visited classic links in Redis, so the next visits skip the database

# These can be left as if if running with Docker
DB_USER='postgres' # change this to your PostgreSQL username
DB_HOST='localhost'
DB_DATABASE='weer'
DB_PASSWORD=''
DB_PORT='5432'