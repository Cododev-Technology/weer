{
  "name": "@weer/server-turbo",
  "version": "1.0.0",
  "description": "URL Shortner Application",
  "scripts": {
    "seed": "./env.sh cargo run --bin seed",
    "test": "./env.sh DB_DATABASE=weer_test NODE_ENV=test cargo test",
    "dev": "./env.sh cargo watch -x 'run --bin index'",
    "janitor": "./env.sh cargo run --bin janitor",
