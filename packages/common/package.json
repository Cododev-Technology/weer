{
  "name": "@weer/common",
  "version": "1.0.0",
  "main": "dist/index.js",
  "typings": "dist/index.d.ts",
  "private": true,
  "devDependencies": {
    "typescript": "^5.9.2",
    "json5": "^2.2.3"
  },
  "scripts": {
    "build:config": "mkdir -p src/config && for f in config/*.json5; do json5 -s 2 -o src/${f%5} $f; done",
    "dev": "yarn build:config && tsc --watch",
    "build": "yarn build:config && tsc"
  }
}
