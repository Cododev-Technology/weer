{
  "compilerOptions": {
    "target": "es6",
    "esModuleInterop": true,
    "module": "CommonJS",
    "moduleResolution": "node",
    "rootDir": "./src",
    "outDir": "./dist",
    "declaration": true,
    "strict": true,
    "resolveJsonModule": true,
    "allowJs": true
  },
  "include": ["src", "src/config/*.json"]
}
